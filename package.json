{
  "name": "personal-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Prateek Sharma's engineering portfolio: projects, case studies, experience and writing.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
