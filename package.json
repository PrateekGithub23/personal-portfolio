  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "vitest": "^4"
  },
  "engines": {
    "node": ">=20.9"
  }
